.git
.gitignore
.env
.env.*
!.env.example

.tools/
.idea/
.vscode/

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/node_modules/
**/dist/
**/coverage/
**/*.tsbuildinfo

docs/
*.log

# Weights, upstream checkpoints and evaluation data stay on the host.
ai_service/models/*.onnx
ai_service/liveness/upstream/
ai_service/evaluation/data/
ai_service/evaluation/results/
**/participant_images/
*.npy

# The liveness model is converted from an Apache-2.0 checkpoint and is small enough to
# ship inside the single-container image; the large recognition weights are fetched at
# build time instead.
!ai_service/models/minifasnet_v2_2.7_80x80.onnx
