# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Generate an encryption key with:  python -c "import secrets,base64;print('k1:' + base64.b64encode(secrets.token_bytes(32)).decode())"

APP_ENV=development                # development | test | production
APP_TIMEZONE=Asia/Kolkata          # institution timezone used for "today" and dates
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://smartattend:CHANGE_ME@localhost:5432/smartattend
TEST_DATABASE_URL=postgresql+psycopg://smartattend:CHANGE_ME@localhost:5432/smartattend_test

# Used only by docker-compose to initialise the postgres container.
# Use a URL-safe secret (python -c "import secrets;print(secrets.token_urlsafe(32))") because
# compose inserts it into DATABASE_URL without percent-encoding.
POSTGRES_PASSWORD=CHANGE_ME

# Auth sessions
SESSION_TTL_MINUTES=480            # absolute lifetime
SESSION_IDLE_MINUTES=60            # idle timeout
COOKIE_SECURE=false                # MUST be true in production (HTTPS)

# docker-compose only: public URL (password-reset links) and the published web port.
# Leave CORS_ORIGINS empty there: nginx serves the SPA and /api from one origin.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Biometric template encryption: comma-separated key_id:base64(32 bytes); the first key encrypts,
# all keys can decrypt (rotation). Losing these keys makes enrolled templates unusable.
BIOMETRIC_ENCRYPTION_KEYS=k1:CHANGE_ME_BASE64_32_BYTES

# AI
MODEL_DIR=../ai_service/models
MAX_UPLOAD_BYTES=2097152

# Development-only admin seed (python -m app.cli seed-admin). Leave empty in production.
# A production deployment creates its first admin with: python -m app.cli create-admin --email ...
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=
